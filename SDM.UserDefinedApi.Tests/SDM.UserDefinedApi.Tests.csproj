<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<RootNamespace>Skyline.DataMiner.SDM.UserDefinedApi.Tests</RootNamespace>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseVSTest>true</UseVSTest>
		<UserSecretsId>8ab48944-9dd8-4a8c-95fd-addc8be03102</UserSecretsId>
		<SonarQubeExclude>true</SonarQubeExclude>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentAssertions" />
		<PackageReference Include="MSTest" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Core" />

		<!-- Needed at compile time, excluded at runtime -->
		<PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" />

		<!-- Locator is the only one that must run at runtime -->
		<PackageReference Include="Microsoft.Build.Locator" />
		<PackageReference Include="Microsoft.OpenApi" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SDM.UserDefinedApi.Runtime\SDM.UserDefinedApi.Runtime.csproj" />
		<ProjectReference Include="..\SDM.UserDefinedApi.Build\SDM.UserDefinedApi.Build.csproj" />
	</ItemGroup>

</Project>
